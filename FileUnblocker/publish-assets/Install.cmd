@echo off
:: ???????????????????????????????????????????????????????????????????????????
:: FileUnblocker — First-run setup
::
:: Windows blocks files copied from other machines (Zone.Identifier ADS).
:: This script removes that block from all files in this folder so the
:: application can run without errors.
::
:: Right-click ? "Run as administrator" if you get access-denied errors.
:: ???????????????????????????????????????????????????????????????????????????

echo.
echo   ????????????????????????????????????????????
echo   ?   FileUnblocker — First-run setup      ?
echo   ????????????????????????????????????????????
echo.
echo   Removing Windows security blocks from all files...
echo.

:: Unblock every file in the current directory and subdirectories
pushd "%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-ChildItem -Recurse -File | Unblock-File"
popd

if %ERRORLEVEL% EQU 0 (
    echo.
    echo   [OK] All files unblocked successfully.
    echo.
) else (
    echo.
    echo   [!] Some files could not be unblocked.
    echo       Try right-clicking this script and choosing "Run as administrator".
 echo.
)

:: Ask if user wants a desktop shortcut
echo.
set /p SHORTCUT="  Create a Desktop shortcut? (Y/N): "
if /i "%SHORTCUT%"=="Y" (
    powershell -NoProfile -ExecutionPolicy Bypass -Command ^
   "$ws = New-Object -ComObject WScript.Shell; $s = $ws.CreateShortcut([Environment]::GetFolderPath('Desktop') + '\FileUnblocker.lnk'); $s.TargetPath = '%~dp0FileUnblocker.exe'; $s.WorkingDirectory = '%~dp0'; $s.Description = 'File Unblocker'; $s.Save()"
  echo.
    echo   [OK] Shortcut created on Desktop.
)

echo.
echo   Setup complete. You can now run FileUnblocker.exe.
echo.
pause
