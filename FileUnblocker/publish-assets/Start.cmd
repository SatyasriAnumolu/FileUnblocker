@echo off
:: ???????????????????????????????????????????????????????????????????????????
:: FileUnblocker — Launcher
::
:: Double-click THIS file to run FileUnblocker on any machine.
:: It automatically removes the Windows "blocked" flag from all files
:: in this folder before launching the application.
::
:: WHY: Windows marks files copied from other machines as "blocked".
:: The .exe crashes before any code runs if it remains blocked.
:: This script fixes that silently on every launch (takes <1 second).
:: ???????????????????????????????????????????????????????????????????????????
cd /d "%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-ChildItem -Path '%~dp0' -Recurse -File | Unblock-File" >nul 2>&1
start "" "%~dp0FileUnblocker.exe" %*
