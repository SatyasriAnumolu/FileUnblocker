<Window x:Class="FileUnblocker.MainWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
   mc:Ignorable="d"
        Title="File Unblocker"
        Height="720" Width="1040" MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
   ResizeMode="CanResizeWithGrip">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
       <GradientStop Color="#0F0F1A" Offset="0"/>
    <GradientStop Color="#1A1A2E" Offset="0.5"/>
          <GradientStop Color="#16162A" Offset="1"/>
      </LinearGradientBrush>
    </Window.Background>

    <!-- ?? Outer shell ?? -->
    <Border CornerRadius="18" ClipToBounds="True">
        <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
         <GradientStop Color="#13131F" Offset="0"/>
      <GradientStop Color="#1A1A2C" Offset="1"/>
            </LinearGradientBrush>
    </Border.Background>
   <Border.Effect>
    <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="8" Opacity="0.7" Direction="270"/>
        </Border.Effect>

        <Grid>
      <Grid.RowDefinitions>
 <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

   <!-- ?? HEADER ?? -->
<Border Grid.Row="0" CornerRadius="18,18,0,0" BorderThickness="0,0,0,1"
    MouseLeftButtonDown="TitleBar_MouseDown">
     <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
     <GradientStop Color="#1A1A30" Offset="0"/>
 <GradientStop Color="#13132A" Offset="0.6"/>
   <GradientStop Color="#0F0F22" Offset="1"/>
        </LinearGradientBrush>
           </Border.Background>
    <Border.BorderBrush>
 <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3A3A58" Offset="0"/>
  <GradientStop Color="#252540" Offset="1"/>
         </LinearGradientBrush>
    </Border.BorderBrush>

            <Grid Margin="20,12,14,12">
  <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
               <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Logo + Title -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                 <Border Width="46" Height="46" CornerRadius="12" Margin="0,0,14,0">
         <Border.Background>
   <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
     <GradientStop Color="#7C3AED" Offset="0"/>
     <GradientStop Color="#2563EB" Offset="1"/>
    </LinearGradientBrush>
                </Border.Background>
         <Border.Effect>
         <DropShadowEffect Color="#7C3AED" BlurRadius="18" ShadowDepth="0" Opacity="0.6"/>
       </Border.Effect>
      <Grid>
                <Rectangle Width="18" Height="13" RadiusX="3" RadiusY="3" Fill="White" Opacity="0.95" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
     <Border Width="10" Height="9" CornerRadius="5,5,0,0" BorderThickness="2.5" BorderBrush="White" Background="Transparent" Opacity="0.95" VerticalAlignment="Center" Margin="0,0,0,8"/>
          <Ellipse Width="4" Height="4" Fill="#6D28D9" VerticalAlignment="Bottom" Margin="0,0,0,11"/>
            </Grid>
      </Border>
        <StackPanel VerticalAlignment="Center">
   <StackPanel Orientation="Horizontal">
       <TextBlock Text="File Unblocker" FontSize="17" FontWeight="Bold"
         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
      <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="6" BorderThickness="1" VerticalAlignment="Center">
            <Border.Background>
         <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
     <GradientStop Color="#2E1065" Offset="0"/>
       <GradientStop Color="#1E1040" Offset="1"/>
 </LinearGradientBrush>
 </Border.Background>
              <Border.BorderBrush>
   <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#6D28D9" Offset="0"/>
        <GradientStop Color="#3B82F6" Offset="1"/>
    </LinearGradientBrush>
             </Border.BorderBrush>
             <TextBlock Text="v1.0.0" FontSize="10" FontWeight="SemiBold"
    Foreground="{DynamicResource AccentDefaultBrush}"/>
                </Border>
            </StackPanel>
      <TextBlock Text="Remove Windows security blocks"
        FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                 </StackPanel>
           </StackPanel>

         <!-- Status pill -->
      <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
        Padding="12,6" CornerRadius="20" BorderThickness="1" BorderBrush="#2A2A42">
        <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A1A2E" Offset="0"/>
             <GradientStop Color="#13131F" Offset="1"/>
             </LinearGradientBrush>
       </Border.Background>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Grid Margin="0,0,7,0" VerticalAlignment="Center">
       <Ellipse Width="12" Height="12">
<Ellipse.Fill>
          <RadialGradientBrush>
      <GradientStop Color="#1DB88440" Offset="0.4"/>
                   <GradientStop Color="Transparent" Offset="1"/>
     </RadialGradientBrush>
      </Ellipse.Fill>
             </Ellipse>
         <Ellipse x:Name="StatusDot" Width="7" Height="7"
     HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
       <RadialGradientBrush>
              <GradientStop Color="{StaticResource StatusSuccess}" Offset="0"/>
  <GradientStop Color="#0D9B6B" Offset="1"/>
           </RadialGradientBrush>
        </Ellipse.Fill>
       <Ellipse.Effect>
            <DropShadowEffect Color="{StaticResource StatusSuccess}" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
  </Ellipse.Effect>
           </Ellipse>
   </Grid>
   <TextBlock x:Name="TxtAppStatus" Text="Ready" FontSize="11" FontWeight="SemiBold"
            Foreground="{DynamicResource StatusSuccessBrush}" VerticalAlignment="Center"/>
       </StackPanel>
           </Border>

             <!-- Theme toggle + Window controls -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
       <ToggleButton x:Name="ThemeToggle" Style="{StaticResource ThemeToggle}" Margin="0,0,8,0"
 Checked="ThemeToggle_Checked" Unchecked="ThemeToggle_Unchecked"/>
    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click"
       Width="34" Height="34" Margin="2,0" BorderThickness="0" Background="Transparent" Cursor="Hand">
     <Button.Template>
                <ControlTemplate TargetType="Button">
           <Border x:Name="Bd" CornerRadius="9" Background="Transparent" Width="34" Height="34">
        <Path Data="M8,17 L26,17" Stroke="#7070A0" StrokeThickness="1.8"
  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Bd" Property="Background" Value="#252542"/>
            </Trigger>
    </ControlTemplate.Triggers>
         </ControlTemplate>
     </Button.Template>
  </Button>
  <Button x:Name="BtnClose" Click="BtnClose_Click"
         Width="34" Height="34" Margin="2,0" BorderThickness="0" Background="Transparent" Cursor="Hand">
   <Button.Template>
       <ControlTemplate TargetType="Button">
  <Border x:Name="Bd" CornerRadius="9" Background="Transparent" Width="34" Height="34">
     <Path Data="M10,10 L24,24 M24,10 L10,24" Stroke="#7070A0" StrokeThickness="1.6"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
     <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
         <Setter TargetName="Bd" Property="Background" Value="#8B1A1A"/>
<Setter TargetName="Bd" Property="Effect">
       <Setter.Value>
            <DropShadowEffect Color="#EF4444" BlurRadius="14" ShadowDepth="0" Opacity="0.4"/>
          </Setter.Value>
           </Setter>
  </Trigger>
                <Trigger Property="IsPressed" Value="True">
       <Setter TargetName="Bd" Property="Background" Value="#B91C1C"/>
     </Trigger>
    </ControlTemplate.Triggers>
</ControlTemplate>
          </Button.Template>
            </Button>
         </StackPanel>
                </Grid>
            </Border>

   <!-- ?? MAIN CONTENT ?? -->
            <Grid Grid.Row="1" Margin="20,16,20,20">

            <Grid.RowDefinitions>
               <RowDefinition Height="Auto"/><!-- Row 0: Action bar       -->
    <RowDefinition Height="Auto"/><!-- Row 1: Smart scan banner-->
     <RowDefinition Height="Auto"/><!-- Row 2: Dashboard cards  -->
          <RowDefinition Height="*"/>   <!-- Row 3: Results table    -->
          <RowDefinition Height="Auto"/><!-- Row 4: Progress bar     -->
     </Grid.RowDefinitions>

    <!-- ?? Action Bar ?? -->
      <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="16,14" Margin="0,0,0,14">
  <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

    <!-- GROUP: Input -->
    <TextBlock Text="ADD FILES" FontSize="9" FontWeight="Bold"
           Foreground="{DynamicResource TextMutedBrush}"
      VerticalAlignment="Center" Margin="0,0,10,0"/>
    <Button Content="&#x1F4C1;  Folder"  Command="{Binding BrowseFolderCommand}"
            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
            ToolTip="Pick a folder to scan"/>
    <Button Content="&#x1F4C4;  Files"   Command="{Binding BrowseFilesCommand}"
            Style="{StaticResource SecondaryButton}" Margin="0,0,16,0"
         ToolTip="Pick individual files"/>

    <Border Width="1" Background="#3A3A55" Margin="0,2,16,2" VerticalAlignment="Stretch"/>

    <!-- GROUP: Options -->
    <TextBlock Text="OPTIONS" FontSize="9" FontWeight="Bold"
      Foreground="{DynamicResource TextMutedBrush}"
        VerticalAlignment="Center" Margin="0,0,10,0"/>
    <CheckBox x:Name="ChkSubfolders"
      Content="Subfolders"
     IsChecked="{Binding Recursive}"
  Style="{StaticResource OptionCheckBox}"
     VerticalAlignment="Center" Margin="0,0,12,0"
    ToolTip="Also scan files inside sub-folders (applies to folder-based scans)"/>
    <CheckBox x:Name="ChkOpenZips"
    IsChecked="{Binding ExpandArchives}"
          Style="{StaticResource ZipOptionCheckBox}"
              VerticalAlignment="Center" Margin="0,0,16,0"
          ToolTip="Extract and unblock files inside .zip and .cab archives">
   <CheckBox.Content>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="&#x1F4E6;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" Opacity="0.7"/>
   <TextBlock Text="Scan ZIP files" VerticalAlignment="Center"/>
    </StackPanel>
 </CheckBox.Content>
    </CheckBox>

    <Border Width="1" Background="#3A3A55" Margin="0,2,16,2" VerticalAlignment="Stretch"/>

    <!-- GROUP: Utilities -->
    <TextBlock Text="REPORT" FontSize="9" FontWeight="Bold"
     Foreground="{DynamicResource TextMutedBrush}"
    VerticalAlignment="Center" Margin="0,0,10,0"/>
    <Button x:Name="BtnClear" Content="&#x1F5D1;  Clear"   Command="{Binding ClearCommand}"
       Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
   ToolTip="Clear the results list and start over"/>
    <Button Content="&#x1F4CB;  Copy"    Command="{Binding CopyReportCommand}"
            Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"
  ToolTip="Copy the list of unblocked files to clipboard"/>
    <Button Content="&#x1F4BE;  Save"    Command="{Binding ExportReportCommand}"
      Style="{StaticResource SecondaryButton}" Margin="0,0,0,0"
  ToolTip="Save a report of unblocked files as a .txt file"/>

    <!-- Accent separator + PRIMARY ACTION -->
    <Border Width="1" Margin="14,2,14,2" VerticalAlignment="Stretch">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#7C3AED" Offset="0"/>
          <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>
   </Border.Background>
    </Border>
    <Button x:Name="BtnUnblock" Content="&#x1F513;  Unblock Files" Command="{Binding UnblockCommand}"
            Style="{StaticResource PrimaryButton}"
 ToolTip="Remove the Windows security block from all queued files"/>
  </WrapPanel>
     </Border>

          <!-- ?? Dashboard Cards ?? -->
     <UniformGrid Grid.Row="2" Rows="1" Margin="0,0,0,14">

  <!-- ?? Total Scanned ?? -->
      <Button Style="{StaticResource DynamicCardButton}" Margin="0,0,8,0"
   Command="{Binding FilterByCardCommand}" CommandParameter="All">
     <Button.Tag>
       <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#1E1E36" Offset="0"/>
    <GradientStop Color="#16162E" Offset="1"/>
   </LinearGradientBrush>
    </Button.Tag>
       <Grid>
      <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
     <TextBlock Text="FILES SCANNED" FontSize="9" FontWeight="Bold"
    Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
    <TextBlock x:Name="CardTotal" Text="0" FontSize="26" FontWeight="Bold"
     Foreground="{DynamicResource TextPrimaryBrush}"/>
    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
  <TextBlock Text="this session" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
       <TextBlock x:Name="CardTrendTotal" Text="{Binding TrendTotal}" FontSize="10"
     Foreground="#A78BFA" Margin="8,0,0,0" FontWeight="SemiBold"
   Visibility="{Binding TrendTotal, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>
   </StackPanel>
   </StackPanel>
 <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" VerticalAlignment="Center">
  <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#2E2E50" Offset="0"/>
     <GradientStop Color="#1E1E3A" Offset="1"/>
     </LinearGradientBrush>
</Border.Background>
        <TextBlock Text="&#x1F4E6;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
   </Grid>
          </Button>

            <!-- ?? Unblocked ?? -->
     <Button Style="{StaticResource DynamicCardButton}" Margin="4,0,4,0"
   Command="{Binding FilterByCardCommand}" CommandParameter="Unblocked">
  <Button.Tag>
     <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#0D2820" Offset="0"/>
 <GradientStop Color="#0A1F18" Offset="1"/>
  </LinearGradientBrush>
          </Button.Tag>
      <Grid>
  <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
 </Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0" VerticalAlignment="Center">
    <TextBlock Text="UNBLOCKED" FontSize="9" FontWeight="Bold" Foreground="#2D7A58" Margin="0,0,0,4"/>
          <TextBlock x:Name="CardUnblocked" Text="0" FontSize="26" FontWeight="Bold"
     Foreground="{DynamicResource StatusSuccessBrush}"/>
        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
         <TextBlock x:Name="CardSuccessRate" Text="{Binding SuccessRate}" FontSize="10" Foreground="#2D7A58"/>
  <TextBlock x:Name="CardTrendUnblocked" Text="{Binding TrendUnblocked}" FontSize="10"
    Foreground="#10B981" Margin="8,0,0,0" FontWeight="SemiBold"
      Visibility="{Binding TrendUnblocked, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>
    </StackPanel>
      </StackPanel>
   <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" VerticalAlignment="Center">
    <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0D3828" Offset="0"/>
 <GradientStop Color="#082418" Offset="1"/>
           </LinearGradientBrush>
</Border.Background>
     <Border.Effect>
   <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
     </Border.Effect>
     <TextBlock Text="&#x2714;" FontSize="18" FontWeight="Bold"
  Foreground="{DynamicResource StatusSuccessBrush}"
       HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     </Grid>
    </Button>

 <!-- ?? Already Clean ?? -->
     <Button Style="{StaticResource DynamicCardButton}" Margin="4,0,4,0"
    Command="{Binding FilterByCardCommand}" CommandParameter="Already Clear">
    <Button.Tag>
         <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
  <GradientStop Color="#1E1E36" Offset="0"/>
  <GradientStop Color="#16162E" Offset="1"/>
  </LinearGradientBrush>
      </Button.Tag>
     <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center">
  <TextBlock Text="ALREADY CLEAN" FontSize="9" FontWeight="Bold"
 Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
<TextBlock x:Name="CardClear" Text="0" FontSize="26" FontWeight="Bold"
          Foreground="{DynamicResource TextSecondaryBrush}"/>
    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
   <TextBlock Text="no action needed" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
      <TextBlock x:Name="CardTrendClear" Text="{Binding TrendClear}" FontSize="10"
     Foreground="#9090A8" Margin="8,0,0,0" FontWeight="SemiBold"
  Visibility="{Binding TrendClear, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>
        </StackPanel>
        </StackPanel>
     <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" VerticalAlignment="Center">
       <Border.Background>
     <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2E2E50" Offset="0"/>
        <GradientStop Color="#1E1E3A" Offset="1"/>
         </LinearGradientBrush>
  </Border.Background>
      <TextBlock Text="&#x2013;" FontSize="20" FontWeight="Bold"
   Foreground="{DynamicResource TextSecondaryBrush}"
    HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
      </Grid>
       </Button>

            <!-- ?? Errors ?? -->
       <Button Style="{StaticResource DynamicCardButton}" Margin="4,0,4,0"
    Command="{Binding FilterByCardCommand}" CommandParameter="Failed">
<Button.Tag>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#2D1010" Offset="0"/>
    <GradientStop Color="#1E0A0A" Offset="1"/>
</LinearGradientBrush>
    </Button.Tag>
 <Grid>
 <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" VerticalAlignment="Center">
  <TextBlock Text="ERRORS" FontSize="9" FontWeight="Bold" Foreground="#8B3A3A" Margin="0,0,0,4"/>
          <TextBlock x:Name="CardFailed" Text="0" FontSize="26" FontWeight="Bold"
       Foreground="{DynamicResource StatusErrorBrush}"/>
  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
      <TextBlock Text="couldn't be unblocked" FontSize="10" Foreground="#8B3A3A"/>
 <TextBlock x:Name="CardTrendFailed" Text="{Binding TrendFailed}" FontSize="10"
 Foreground="#F87171" Margin="8,0,0,0" FontWeight="SemiBold"
 Visibility="{Binding TrendFailed, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>
     </StackPanel>
      </StackPanel>
    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" VerticalAlignment="Center">
  <Border.Background>
  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#3D1010" Offset="0"/>
 <GradientStop Color="#280808" Offset="1"/>
   </LinearGradientBrush>
      </Border.Background>
    <Border.Effect>
     <DropShadowEffect Color="#F87171" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
  </Border.Effect>
      <TextBlock Text="&#x2716;" FontSize="16" FontWeight="Bold"
    Foreground="{DynamicResource StatusErrorBrush}"
        HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </Grid>
          </Button>

  <!-- ?? Last Operation ?? -->
      <Button Style="{StaticResource DynamicCardButton}" Margin="8,0,0,0"
   IsHitTestVisible="False" Cursor="Arrow">
        <Button.Tag>
     <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
  <GradientStop Color="#1A1630" Offset="0"/>
 <GradientStop Color="#131228" Offset="1"/>
   </LinearGradientBrush>
</Button.Tag>
       <StackPanel VerticalAlignment="Center">
           <TextBlock Text="LAST RUN" FontSize="9" FontWeight="Bold"
   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
 <TextBlock x:Name="CardLastTime" Text="{Binding LastOperationTime}"
FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentDefaultBrush}"/>
      <TextBlock x:Name="CardLastDetail" Text="{Binding LastOperationDetail}"
    FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
       Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
          </Button>

     </UniformGrid>

     <!-- ?? Results Table ?? -->
   <Border Grid.Row="3" Style="{StaticResource GlassCard}" Padding="0" ClipToBounds="True"
       AllowDrop="True"
           DragEnter="DropZone_DragEnter"
           DragLeave="DropZone_DragLeave"
      DragOver="DropZone_DragOver"
           Drop="DropZone_Drop"
           x:Name="DropZoneBorder">

  <Grid>
   <Grid.RowDefinitions>
  <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
   </Grid.RowDefinitions>

    <!-- ?? Table header + filter/sort bar ?? -->
    <Border Grid.Row="0" CornerRadius="14,14,0,0"
   BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderDefaultBrush}">
      <Border.Background>
  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
  <GradientStop Color="#252540" Offset="0"/>
  <GradientStop Color="#1E1E36" Offset="1"/>
      </LinearGradientBrush>
       </Border.Background>
      <Grid Margin="14,9">
     <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
   <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

   <!-- Title + row count badge -->
  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentDefaultBrush}"
   VerticalAlignment="Center" Margin="0,0,8,0">
       <Ellipse.Effect>
  <DropShadowEffect Color="{DynamicResource AccentDefault}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
    </Ellipse.Effect>
        </Ellipse>
       <TextBlock x:Name="TxtLogHeader" Text="Results"
   Foreground="{DynamicResource TextSecondaryBrush}"
  FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Border x:Name="BadgeCount" Padding="7,2" CornerRadius="10" Margin="8,0,0,0"
     Background="{DynamicResource BgInputBrush}"
      BorderBrush="{DynamicResource BorderDefaultBrush}"
  BorderThickness="1" Visibility="Collapsed">
     <TextBlock x:Name="TxtRowCount" Text="0"
 Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
    </Border>
         </StackPanel>

        <!-- Filter chips + sort buttons -->
  <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="Filter:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
    VerticalAlignment="Center" Margin="0,0,6,0"/>
    <RadioButton Content="All"       GroupName="Filter" IsChecked="True"
     Style="{StaticResource FilterChip}" Tag="All"    Click="FilterChip_Click" Margin="0,0,4,0"/>
    <RadioButton Content="Blocked"      GroupName="Filter"
     Style="{StaticResource FilterChip}" Tag="Blocked" Click="FilterChip_Click" Margin="0,0,4,0"/>
   <RadioButton Content="Unblocked"    GroupName="Filter"
    Style="{StaticResource FilterChip}" Tag="Unblocked" Click="FilterChip_Click" Margin="0,0,4,0"/>
    <RadioButton Content="Archives"    GroupName="Filter"
   Style="{StaticResource FilterChip}" Tag="Archives" Click="FilterChip_Click" Margin="0,0,4,0"/>
    <RadioButton Content="Failed"       GroupName="Filter"
     Style="{StaticResource FilterChip}" Tag="Failed"  Click="FilterChip_Click" Margin="0,0,12,0"/>

    <Border Width="1" Background="#3A3A55" Margin="0,2,12,2" VerticalAlignment="Stretch"/>
    <TextBlock Text="Sort:" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
    VerticalAlignment="Center" Margin="0,0,6,0"/>
    <Button Content="Name"     Style="{StaticResource SortChip}"
   Command="{Binding ToggleSortCommand}" CommandParameter="File Name" Margin="0,0,4,0"/>
    <Button Content="Size"     Style="{StaticResource SortChip}"
    Command="{Binding ToggleSortCommand}" CommandParameter="Size"     Margin="0,0,4,0"/>
    <Button Content="Status"   Style="{StaticResource SortChip}"
  Command="{Binding ToggleSortCommand}" CommandParameter="Status"   Margin="0,0,4,0"/>
    <Button Content="Modified" Style="{StaticResource SortChip}"
    Command="{Binding ToggleSortCommand}" CommandParameter="Modified" Margin="0,0,0,0"/>
     </WrapPanel>
   </Grid>
    </Border>

    <!-- ?? Data rows ?? -->
    <ListView Grid.Row="1" x:Name="LogList"
    ItemsSource="{Binding ItemsView}"
  Background="Transparent" BorderThickness="0"
 ItemContainerStyle="{StaticResource TableRow}"
   ScrollViewer.HorizontalScrollBarVisibility="Auto"
    VirtualizingPanel.IsVirtualizing="True"
    VirtualizingPanel.VirtualizationMode="Recycling"
    SelectionMode="Extended"
    Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">

      <!-- ?? Right-click context menu ?? -->
      <ListView.ContextMenu>
    <ContextMenu Style="{StaticResource GlassContextMenu}">
     <MenuItem Style="{StaticResource GlassMenuItem}"
       Command="{Binding PlacementTarget.DataContext.OpenFolderItemCommand,
RelativeSource={RelativeSource AncestorType=ContextMenu}}"
   CommandParameter="{Binding PlacementTarget.SelectedItem,
 RelativeSource={RelativeSource AncestorType=ContextMenu}}">
    <MenuItem.Header>
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="&#x1F4C2;  " FontSize="12"/>
       <TextBlock Text="Open file location"/>
   </StackPanel>
       </MenuItem.Header>
    </MenuItem>
    <MenuItem Style="{StaticResource GlassMenuItem}"
    Command="{Binding PlacementTarget.DataContext.CopyPathItemCommand,
RelativeSource={RelativeSource AncestorType=ContextMenu}}"
 CommandParameter="{Binding PlacementTarget.SelectedItem,
RelativeSource={RelativeSource AncestorType=ContextMenu}}">
      <MenuItem.Header>
  <StackPanel Orientation="Horizontal">
  <TextBlock Text="&#x1F4CB;  " FontSize="12"/>
    <TextBlock Text="Copy full path"/>
</StackPanel>
      </MenuItem.Header>
 </MenuItem>
 <Separator Style="{StaticResource GlassMenuSeparator}"/>
    <MenuItem Style="{StaticResource GlassMenuItem}"
   Command="{Binding PlacementTarget.DataContext.RetryItemCommand,
 RelativeSource={RelativeSource AncestorType=ContextMenu}}"
  CommandParameter="{Binding PlacementTarget.SelectedItem,
RelativeSource={RelativeSource AncestorType=ContextMenu}}">
      <MenuItem.Header>
<StackPanel Orientation="Horizontal">
  <TextBlock Text="&#x1F504;  " FontSize="12"/>
   <TextBlock Text="Retry unblock"/>
    </StackPanel>
   </MenuItem.Header>
 </MenuItem>
     </ContextMenu>
     </ListView.ContextMenu>

      <ListView.View>
  <GridView ColumnHeaderContainerStyle="{StaticResource TableHeaderCell}">

          <!-- ?? STATUS ????????????????????????????????????????????????? -->
       <GridViewColumn Width="148">
     <GridViewColumn.Header>
       <Button Style="{StaticResource SortChip}"
      Command="{Binding DataContext.ToggleSortCommand,
RelativeSource={RelativeSource AncestorType=ListView}}"
        CommandParameter="Status" Padding="0">
    <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold"
Foreground="{DynamicResource TextSecondaryBrush}"/>
      </Button>
      </GridViewColumn.Header>
       <GridViewColumn.CellTemplate>
     <DataTemplate>
          <!-- Coloured pill badge -->
    <Border Margin="10,5" Padding="8,4" CornerRadius="8"
  BorderThickness="1">
      <Border.BorderBrush>
         <SolidColorBrush Color="{Binding StatusColour}" Opacity="0.45"/>
      </Border.BorderBrush>
      <Border.Background>
       <SolidColorBrush Color="{Binding StatusColour}" Opacity="0.12"/>
          </Border.Background>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="{Binding StatusIcon}" FontSize="11" FontWeight="Bold"
       VerticalAlignment="Center" Margin="0,0,5,0">
  <TextBlock.Foreground><SolidColorBrush Color="{Binding StatusColour}"/></TextBlock.Foreground>
      </TextBlock>
    <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
          VerticalAlignment="Center">
     <TextBlock.Foreground><SolidColorBrush Color="{Binding StatusColour}"/></TextBlock.Foreground>
       </TextBlock>
          </StackPanel>
      </Border>
  </DataTemplate>
        </GridViewColumn.CellTemplate>
   </GridViewColumn>

    <!-- ?? FILE NAME ?????????????????????????????????????????????? -->
    <GridViewColumn Width="210">
   <GridViewColumn.Header>
      <Button Style="{StaticResource SortChip}"
      Command="{Binding DataContext.ToggleSortCommand,
RelativeSource={RelativeSource AncestorType=ListView}}"
       CommandParameter="File Name" Padding="0">
         <TextBlock Text="FILE NAME" FontSize="10" FontWeight="Bold"
  Foreground="{DynamicResource TextSecondaryBrush}"/>
      </Button>
   </GridViewColumn.Header>
    <GridViewColumn.CellTemplate>
 <DataTemplate>
       <StackPanel Orientation="Horizontal" Margin="10,5">

  <!-- Vector icon badge -->
         <Border Width="26" Height="26" CornerRadius="7" Margin="0,0,7,0"
   Background="{DynamicResource BgInputBrush}">
  <Border.Effect>
    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.25"
     Color="{Binding FullPath,
Converter={StaticResource FileTypeColorConverter},
ConverterParameter=color}"/>
 </Border.Effect>
  <Viewbox Width="14" Height="14">
     <Canvas Width="20" Height="20">
    <Path Fill="Transparent" StrokeThickness="1.4"
         StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
      Data="{Binding FullPath, Converter={StaticResource FileTypeIconConverter}}">
           <Path.Stroke>
  <SolidColorBrush
Color="{Binding FullPath,
Converter={StaticResource FileTypeColorConverter},
ConverterParameter=color}"/>
       </Path.Stroke>
          </Path>
      </Canvas>
    </Viewbox>
    </Border>

    <!-- File name + size -->
  <StackPanel VerticalAlignment="Center">
    <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold"
     Foreground="{DynamicResource TextPrimaryBrush}"
     ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" MaxWidth="155"/>
     <TextBlock Text="{Binding SizeDisplay}" FontSize="10"
      Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
      </StackPanel>
      </StackPanel>
     </DataTemplate>
    </GridViewColumn.CellTemplate>
    </GridViewColumn>

  <!-- ?? PATH ???????????????????????????????????????????????????? -->
    <GridViewColumn Width="195">
  <GridViewColumn.Header>
      <TextBlock Text="PATH" FontSize="10" FontWeight="Bold"
  Foreground="{DynamicResource TextSecondaryBrush}" Padding="4,0"/>
      </GridViewColumn.Header>
   <GridViewColumn.CellTemplate>
     <DataTemplate>
      <TextBlock Text="{Binding Directory}" Style="{StaticResource CellMuted}"
   ToolTip="{Binding FullPath}" Padding="10,8" TextTrimming="CharacterEllipsis"/>
    </DataTemplate>
    </GridViewColumn.CellTemplate>
   </GridViewColumn>

    <!-- ?? SIZE ???????????????????????????????????????????????????? -->
    <GridViewColumn Width="78">
    <GridViewColumn.Header>
    <Button Style="{StaticResource SortChip}"
      Command="{Binding DataContext.ToggleSortCommand,
RelativeSource={RelativeSource AncestorType=ListView}}"
   CommandParameter="Size" Padding="0">
         <TextBlock Text="SIZE" FontSize="10" FontWeight="Bold"
Foreground="{DynamicResource TextSecondaryBrush}"/>
      </Button>
       </GridViewColumn.Header>
       <GridViewColumn.CellTemplate>
      <DataTemplate>
   <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource CellMuted}" Padding="10,8"/>
 </DataTemplate>
     </GridViewColumn.CellTemplate>
   </GridViewColumn>

    <!-- ?? MODIFIED ???????????????????????????????????????????????? -->
    <GridViewColumn Width="145">
    <GridViewColumn.Header>
     <Button Style="{StaticResource SortChip}"
       Command="{Binding DataContext.ToggleSortCommand,
RelativeSource={RelativeSource AncestorType=ListView}}"
     CommandParameter="Modified" Padding="0">
       <TextBlock Text="MODIFIED" FontSize="10" FontWeight="Bold"
Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Button>
      </GridViewColumn.Header>
       <GridViewColumn.CellTemplate>
      <DataTemplate>
   <TextBlock Text="{Binding ModifiedDisplay}" Style="{StaticResource CellMuted}" Padding="10,8"/>
      </DataTemplate>
       </GridViewColumn.CellTemplate>
    </GridViewColumn>

  <!-- ?? NOTE ???????????????????????????????????????????????????? -->
   <GridViewColumn Width="185">
   <GridViewColumn.Header>
    <TextBlock Text="NOTE" FontSize="10" FontWeight="Bold"
    Foreground="{DynamicResource TextSecondaryBrush}" Padding="4,0"/>
        </GridViewColumn.Header>
     <GridViewColumn.CellTemplate>
  <DataTemplate>
  <Border Padding="10,6">
   <TextBlock Text="{Binding NoteDisplay}" FontSize="11"
   TextTrimming="CharacterEllipsis"
   ToolTip="{Binding NoteDisplay}"
     Foreground="{DynamicResource TextMutedBrush}"
     MaxWidth="165"/>
    </Border>
     </DataTemplate>
    </GridViewColumn.CellTemplate>
    </GridViewColumn>

    <!-- ?? ACTIONS ????????????????????????????????????????????????? -->
   <GridViewColumn Width="108">
    <GridViewColumn.Header>
     <TextBlock Text="ACTIONS" FontSize="10" FontWeight="Bold"
  Foreground="{DynamicResource TextSecondaryBrush}" Padding="4,0"/>
     </GridViewColumn.Header>
      <GridViewColumn.CellTemplate>
     <DataTemplate>
    <StackPanel Orientation="Horizontal" Margin="6,3">
    <!-- Open file location -->
       <Button Style="{StaticResource RowIconButton}" Margin="0,0,3,0"
        Command="{Binding DataContext.OpenFolderItemCommand,
RelativeSource={RelativeSource AncestorType=ListView}}"
   CommandParameter="{Binding}"
    ToolTip="Open file location">
        <TextBlock Text="&#x1F4C2;" FontSize="13"
  HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Button>
   <!-- Copy path -->
        <Button Style="{StaticResource RowIconButton}" Margin="0,0,3,0"
Command="{Binding DataContext.CopyPathItemCommand,
RelativeSource={RelativeSource AncestorType=ListView}}"
    CommandParameter="{Binding}"
  ToolTip="Copy full path">
 <TextBlock Text="&#x1F4CB;" FontSize="13"
 HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Button>
  <Button Style="{StaticResource RowIconButton}"
   Command="{Binding DataContext.RetryItemCommand,
RelativeSource={RelativeSource AncestorType=ListView}}"
 CommandParameter="{Binding}"
    ToolTip="Retry unblock">
<TextBlock Text="&#x1F504;" FontSize="13"
 HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Button>
       </StackPanel>
   </DataTemplate>
      </GridViewColumn.CellTemplate>
   </GridViewColumn>

   </GridView>
      </ListView.View>
  </ListView>

    <!-- ?? Empty-state overlay (shown when no files are loaded) ?? -->
    <Border Grid.Row="1" x:Name="EmptyStateOverlay"
Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
          Background="Transparent"
          AllowDrop="True"
          DragEnter="DropZone_DragEnter"
        DragLeave="DropZone_DragLeave"
      DragOver="DropZone_DragOver"
     Drop="DropZone_Drop">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,32">

    <!-- Drag-zone icon with glow ring -->
      <Border x:Name="DropIconRing"
     Width="100" Height="100" CornerRadius="50"
      HorizontalAlignment="Center" Margin="0,0,0,24"
     BorderThickness="2.5">
   <Border.BorderBrush>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
           <GradientStop Color="#7C3AED" Offset="0"/>
        <GradientStop Color="#2563EB" Offset="1"/>
    </LinearGradientBrush>
    </Border.BorderBrush>
   <Border.Background>
     <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
       <GradientStop Color="#1E1E3A" Offset="0"/>
  <GradientStop Color="#16162E" Offset="1"/>
         </LinearGradientBrush>
        </Border.Background>
  <Border.Effect>
     <DropShadowEffect Color="#7C3AED" BlurRadius="20" ShadowDepth="0" Opacity="0.35"/>
     </Border.Effect>
 <TextBlock x:Name="DropIconText" Text="&#x1F513;" FontSize="40"
      HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>

        <!-- Primary message -->
  <TextBlock x:Name="DropHeadline"
    Text="Drag &amp; drop files or folders here"
   FontSize="18" FontWeight="SemiBold"
   Foreground="{DynamicResource TextPrimaryBrush}"
         HorizontalAlignment="Center" Margin="0,0,0,8"/>

      <!-- Drag-over message (hidden by default, shown on hover) -->
      <TextBlock x:Name="DropHoverHint"
     Text="Release to add to queue"
        FontSize="14" FontWeight="SemiBold"
Foreground="{DynamicResource AccentDefaultBrush}"
     HorizontalAlignment="Center" Margin="0,0,0,8"
       Visibility="Collapsed"/>

     <!-- Secondary message -->
 <TextBlock x:Name="DropInstruction"
     FontSize="13" TextAlignment="Center"
        Foreground="{DynamicResource TextSecondaryBrush}"
        HorizontalAlignment="Center" MaxWidth="380" LineHeight="22">
     <Run Text="or click "/>
      <Run Text="Folder" Foreground="{DynamicResource AccentDefaultBrush}" FontWeight="SemiBold"/>
     <Run Text=" or "/>
      <Run Text="Files" Foreground="{DynamicResource AccentDefaultBrush}" FontWeight="SemiBold"/>
       <Run Text=" above to get started"/>
     </TextBlock>

     <!-- Subtext with supported formats -->
     <Border Padding="12,6" CornerRadius="8" Margin="0,20,0,0"
      HorizontalAlignment="Center" BorderThickness="1">
     <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
  <GradientStop Color="#1A1A2E" Offset="0"/>
    <GradientStop Color="#13131F" Offset="1"/>
        </LinearGradientBrush>
     </Border.Background>
     <Border.BorderBrush>
     <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
<GradientStop Color="#3A3A58" Offset="0"/>
           <GradientStop Color="#252540" Offset="1"/>
       </LinearGradientBrush>
     </Border.BorderBrush>
   <TextBlock Text="Supports individual files, folders, ZIP and CAB archives"
        FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
HorizontalAlignment="Center"/>
       </Border>
  </StackPanel>
    </Border>

  </Grid>
    </Border>
        <!-- ?? Progress Bar + Real-time Feedback ?? -->
        <Border Grid.Row="4" Style="{StaticResource GlassCard}" Padding="16,10" Margin="0,14,0,0">
            <Grid>
         <Grid.RowDefinitions>
           <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

     <!-- Top row: phase pill | current file | metrics | cancel -->
  <Grid Grid.Row="0" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
   <ColumnDefinition Width="Auto"/>
           <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>

          <!-- Phase pill -->
           <Border Grid.Column="0" Padding="8,3" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center"
    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
          <Border.Background>
             <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
         <GradientStop Color="#3A2E6A" Offset="0"/>
              <GradientStop Color="#1E1E40" Offset="1"/>
     </LinearGradientBrush>
 </Border.Background>
  <TextBlock Text="{Binding ProcessingPhase}" FontSize="10" FontWeight="Bold"
         Foreground="{DynamicResource AccentDefaultBrush}" VerticalAlignment="Center"/>
    </Border>

      <!-- Current file -->
       <TextBlock Grid.Column="1" Text="{Binding CurrentFile}" FontSize="11"
  Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
      TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentFile}"/>

               <!-- Right: speed + elapsed + ETA + cancel + idle status -->
           <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Padding="8,3" CornerRadius="6" Background="#1E1E30" Margin="0,0,6,0"
   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
       <StackPanel Orientation="Horizontal">
  <TextBlock Text="&#x26A1; " FontSize="10" Foreground="#A78BFA"/>
   <TextBlock Text="{Binding SpeedLabel}" FontSize="10" FontWeight="SemiBold"
          Foreground="{DynamicResource AccentDefaultBrush}"/>
   </StackPanel>
   </Border>
          <Border Padding="8,3" CornerRadius="6" Background="#1E1E30" Margin="0,0,6,0"
      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
  <StackPanel Orientation="Horizontal">
     <TextBlock Text="&#x23F1; " FontSize="10" Foreground="#60A5FA"/>
         <TextBlock Text="{Binding ElapsedDisplay}" FontSize="10" FontWeight="SemiBold"
        Foreground="{DynamicResource StatusInfoBrush}"/>
   </StackPanel>
       </Border>
        <Border Padding="8,3" CornerRadius="6" Background="#1E1E30" Margin="0,0,8,0"
               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
         <StackPanel Orientation="Horizontal">
 <TextBlock Text="ETA " FontSize="10" Foreground="#6B7280"/>
<TextBlock Text="{Binding EtaDisplay}" FontSize="10" FontWeight="SemiBold"
Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
         </Border>
        <Button Content="&#x2715;  Cancel" Command="{Binding CancelCommand}"
   Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="10" Margin="0,0,8,0"
 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
   ToolTip="Cancel current operation"/>
    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#8888AA"
     TextAlignment="Right" MinWidth="200" VerticalAlignment="Center"
         Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibilityConverter}}"/>
         </StackPanel>
     </Grid>

         <!-- Progress bar row -->
       <Grid Grid.Row="1">
       <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
  <ProgressBar x:Name="ProgressBar" Grid.Column="0"
       Style="{StaticResource GlassProgress}"
Minimum="0" Maximum="100" Value="0" Margin="0,0,12,0"
     IsIndeterminate="{Binding IsIndeterminate}"/>
         <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}"
           FontSize="11" FontWeight="SemiBold"
   Foreground="{DynamicResource AccentDefaultBrush}"
        MinWidth="120" TextAlignment="Right" VerticalAlignment="Center"/>
         </Grid>
 </Grid>
        </Border>

    </Grid>
    </Grid>
    </Border>
</Window>
