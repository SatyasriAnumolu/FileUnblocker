<Window x:Class="FileUnblocker.ResultSummaryDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileUnblocker.ViewModels"
   Title="Processing Complete"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
   ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Background>
      <SolidColorBrush Color="#00000000"/>
    </Window.Background>

 <!-- outer drop-shadow shell -->
    <Border x:Name="RootBorder" CornerRadius="16" Margin="12">
        <Border.Background>
       <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
     <GradientStop Color="#1A1A2E" Offset="0"/>
 <GradientStop Color="#13131F" Offset="1"/>
       </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
        <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8"
     Opacity="0.75" Direction="270"/>
        </Border.Effect>
 <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#3A3A58" Offset="0"/>
          <GradientStop Color="#252540" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
  <Border.BorderThickness>1</Border.BorderThickness>

        <Grid>
 <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>  <!-- title bar -->
                <RowDefinition Height="Auto"/>  <!-- hero icon + headline -->
     <RowDefinition Height="Auto"/>  <!-- stat row -->
           <RowDefinition Height="Auto"/>  <!-- detail rows -->
              <RowDefinition Height="Auto"/>  <!-- action bar -->
       </Grid.RowDefinitions>

  <!-- ?? Title bar ??????????????????????????????????????????????? -->
            <Grid Grid.Row="0" Margin="20,14,14,0"
            MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
             <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
           <TextBlock Grid.Column="0" Text="Finished"
       FontSize="12" FontWeight="SemiBold"
          Foreground="#7070A0" VerticalAlignment="Center"/>
<Button Grid.Column="1" x:Name="BtnClose" Click="BtnClose_Click"
Width="28" Height="28" BorderThickness="0"
       Background="Transparent" Cursor="Hand">
     <Button.Template>
           <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
      Width="28" Height="28">
              <Path Data="M8,8 L20,20 M20,8 L8,20"
          Stroke="#6060A0" StrokeThickness="1.5"
         StrokeStartLineCap="Round" StrokeEndLineCap="Round"
       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
      <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="Bd" Property="Background" Value="#1E1E38"/>
         </Trigger>
           </ControlTemplate.Triggers>
         </ControlTemplate>
    </Button.Template>
        </Button>
        </Grid>

     <!-- ?? Hero area: large icon + headline ???????????????????????? -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center"
       Margin="20,20,20,4">

        <!-- animated glow ring + icon -->
         <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
            <!-- glow ring -->
      <Ellipse x:Name="GlowRing" Width="80" Height="80">
  <Ellipse.Fill>
  <RadialGradientBrush>
         <GradientStop x:Name="GlowStop"
       Color="#2010B981" Offset="0.5"/>
       <GradientStop Color="Transparent" Offset="1"/>
          </RadialGradientBrush>
              </Ellipse.Fill>
    </Ellipse>
         <!-- icon badge -->
     <Border x:Name="HeroBadge" Width="60" Height="60"
            CornerRadius="18" HorizontalAlignment="Center"
      VerticalAlignment="Center">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
     <GradientStop x:Name="BadgeGrad0" Color="#0D3828" Offset="0"/>
 <GradientStop x:Name="BadgeGrad1" Color="#082418" Offset="1"/>
                 </LinearGradientBrush>
         </Border.Background>
      <Border.Effect>
           <DropShadowEffect x:Name="BadgeShadow"
             Color="#10B981" BlurRadius="16"
         ShadowDepth="0" Opacity="0.5"/>
   </Border.Effect>
  <Viewbox Width="28" Height="28">
           <Canvas Width="24" Height="24">
              <!-- check mark path (success) -->
       <Path x:Name="IconPath"
        Data="M5,12 L10,17 L19,7"
           Stroke="#10B981" StrokeThickness="2.2"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
         StrokeLineJoin="Round" Fill="Transparent"/>
  </Canvas>
     </Viewbox>
      </Border>
      </Grid>

                <!-- headline text -->
      <TextBlock x:Name="TxtHeadline"
     HorizontalAlignment="Center"
     FontSize="16" FontWeight="Bold"
   TextAlignment="Center" TextWrapping="Wrap"
      MaxWidth="340" Margin="0,0,0,4"/>

      <!-- sub-headline: time + rate -->
  <TextBlock x:Name="TxtSubHeadline"
            HorizontalAlignment="Center"
     FontSize="11" TextAlignment="Center"
      Foreground="#7070A0" Margin="0,0,0,4"/>
         </StackPanel>

       <!-- ?? Stat row ????????????????????????????????????????????????? -->
            <UniformGrid Grid.Row="2" Rows="1" Margin="20,12,20,0">

  <!-- Unblocked -->
   <Border Margin="0,0,5,0" CornerRadius="10" Padding="10,8" BorderThickness="1">
          <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#0D2820" Offset="0"/>
    <GradientStop Color="#0A1F18" Offset="1"/>
        </LinearGradientBrush>
       </Border.Background>
        <Border.BorderBrush>
         <SolidColorBrush Color="#1A4A38"/>
             </Border.BorderBrush>
        <StackPanel HorizontalAlignment="Center">
      <TextBlock x:Name="StatUnblocked" Text="0"
      FontSize="22" FontWeight="Bold"
       Foreground="#10B981" HorizontalAlignment="Center"/>
<TextBlock Text="Unblocked" FontSize="9" FontWeight="SemiBold"
Foreground="#2D7A58" HorizontalAlignment="Center"
 Margin="0,2,0,0"/>
    </StackPanel>
      </Border>

       <!-- Already Clear -->
           <Border Margin="3,0" CornerRadius="10" Padding="10,8" BorderThickness="1">
     <Border.Background>
   <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#1E1E36" Offset="0"/>
        <GradientStop Color="#16162E" Offset="1"/>
        </LinearGradientBrush>
  </Border.Background>
<Border.BorderBrush>
           <SolidColorBrush Color="#2E2E50"/>
          </Border.BorderBrush>
    <StackPanel HorizontalAlignment="Center">
   <TextBlock x:Name="StatClear" Text="0"
   FontSize="22" FontWeight="Bold"
             Foreground="#C4B5FD" HorizontalAlignment="Center"/>
        <TextBlock Text="Already Clear" FontSize="9" FontWeight="SemiBold"
      Foreground="#5B4A80" HorizontalAlignment="Center"
 Margin="0,2,0,0"/>
   </StackPanel>
                </Border>

      <!-- Archives -->
      <Border Margin="3,0" CornerRadius="10" Padding="10,8" BorderThickness="1"
    x:Name="StatArchiveBorder">
          <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
         <GradientStop Color="#1E1830" Offset="0"/>
     <GradientStop Color="#16122A" Offset="1"/>
           </LinearGradientBrush>
</Border.Background>
        <Border.BorderBrush>
     <SolidColorBrush Color="#3A2E5A"/>
     </Border.BorderBrush>
        <StackPanel HorizontalAlignment="Center">
          <TextBlock x:Name="StatArchives" Text="0"
  FontSize="22" FontWeight="Bold"
       Foreground="#A78BFA" HorizontalAlignment="Center"/>
        <TextBlock Text="Archives" FontSize="9" FontWeight="SemiBold"
         Foreground="#5B4A80" HorizontalAlignment="Center"
      Margin="0,2,0,0"/>
  </StackPanel>
          </Border>

      <!-- Failed -->
         <Border Margin="5,0,0,0" CornerRadius="10" Padding="10,8" BorderThickness="1"
    x:Name="StatFailedBorder">
       <Border.Background>
               <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2D1010" Offset="0"/>
  <GradientStop Color="#1E0A0A" Offset="1"/>
     </LinearGradientBrush>
     </Border.Background>
            <Border.BorderBrush>
        <SolidColorBrush Color="#4A1818"/>
     </Border.BorderBrush>
             <StackPanel HorizontalAlignment="Center">
          <TextBlock x:Name="StatFailed" Text="0"
     FontSize="22" FontWeight="Bold"
  Foreground="#F87171" HorizontalAlignment="Center"/>
          <TextBlock Text="Failed" FontSize="9" FontWeight="SemiBold"
 Foreground="#8B3A3A" HorizontalAlignment="Center"
 Margin="0,2,0,0"/>
     </StackPanel>
 </Border>

         </UniformGrid>

         <!-- ?? Detail rows ?????????????????????????????????????????????? -->
     <StackPanel Grid.Row="3" Margin="20,14,20,0">

   <!-- divider -->
      <Border Height="1" Margin="0,0,0,12">
        <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
       <GradientStop Color="Transparent" Offset="0"/>
      <GradientStop Color="#3A3A55" Offset="0.3"/>
    <GradientStop Color="#3A3A55" Offset="0.7"/>
   <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>
    </Border.Background>
    </Border>

        <!-- Total processed -->
          <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/>
   <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
  <TextBlock Grid.Column="0" Text="Files processed"
   FontSize="11" Foreground="#7070A0"/>
<Border Grid.Column="2" Height="1" Background="#3A3A55"
   VerticalAlignment="Center" Margin="8,0"/>
   <TextBlock x:Name="TxtTotal" Grid.Column="2"
        FontSize="11" FontWeight="SemiBold"
      Foreground="#C4B5FD"/>
     </Grid>

<!-- Time taken -->
       <Grid Margin="0,0,0,8">
                 <Grid.ColumnDefinitions>
         <ColumnDefinition Width="Auto"/>
   <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
     <TextBlock Grid.Column="0" Text="Time taken"
FontSize="11" Foreground="#7070A0"/>
 <TextBlock x:Name="TxtElapsed" Grid.Column="2"
      FontSize="11" FontWeight="SemiBold"
         Foreground="#60A5FA"/>
  </Grid>

     <!-- Success rate -->
     <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/>
  <ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Text="Success rate"
     FontSize="11" Foreground="#7070A0"/>
      <TextBlock x:Name="TxtSuccessRate" Grid.Column="2"
          FontSize="11" FontWeight="SemiBold"
               Foreground="#10B981"/>
  </Grid>

        </StackPanel>

            <!-- ?? Action bar ??????????????????????????????????????????????? -->
            <Grid Grid.Row="4" Margin="20,16,20,20">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>

   <!-- "View results" links to filter -->
      <Button x:Name="BtnViewResults" Grid.Column="0"
        Content="Show results" Click="BtnViewResults_Click"
    HorizontalAlignment="Left"
    Padding="0" BorderThickness="0"
         Background="Transparent" Cursor="Hand"
       FontSize="12" FontWeight="SemiBold"
        Foreground="#A78BFA"/>

    <!-- Dismiss / OK -->
      <Button x:Name="BtnDismiss" Grid.Column="1"
          Content="Done" Click="BtnDismiss_Click"
         Padding="28,10" Cursor="Hand"
       BorderThickness="0" FontSize="13" FontWeight="SemiBold"
 Foreground="White">
           <Button.Template>
         <ControlTemplate TargetType="Button">
           <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}">
          <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>
          </Border.Background>
                  <Border.Effect>
         <DropShadowEffect Color="#7C3AED" BlurRadius="14"
   ShadowDepth="0" Opacity="0.55"/>
         </Border.Effect>
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
              <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
   <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                  </Trigger>
   <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
           </Trigger>
    </ControlTemplate.Triggers>
             </ControlTemplate>
  </Button.Template>
 </Button>
            </Grid>

        </Grid>
    </Border>
</Window>
